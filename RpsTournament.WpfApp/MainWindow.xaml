<Window x:Class="RpsTournament.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Turniir: Kivi-Paber-Käärid" Height="450" Width="620" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Mängija nimi: " VerticalAlignment="Center" FontWeight="Bold"/>
            <TextBox x:Name="PlayerNameTextBox" Width="200" Margin="10,0,0,0" Padding="3"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Sinu käik: " VerticalAlignment="Center" FontWeight="Bold"/>
            <ComboBox x:Name="MoveComboBox" Width="120" Margin="10,0,15,0"/>
            <Button x:Name="PlayRoundButton" Content="Tee käik" Click="PlayRoundButton_Click" Padding="10,5"/>
            <Button x:Name="NewGameButton" Content="Uus turniir" Click="NewGameButton_Click" Margin="15,0,0,0" Padding="10,5"/>
        </StackPanel>

        <DataGrid x:Name="RoundsDataGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Raund" Binding="{Binding RoundNumber}" Width="60"/>
                <DataGridTextColumn Header="Mängija" Binding="{Binding PlayerName}" Width="120"/>
                <DataGridTextColumn Header="Mängija käik" Binding="{Binding PlayerMove}" Width="110"/>
                <DataGridTextColumn Header="Arvuti käik" Binding="{Binding ComputerMove}" Width="110"/>
                <DataGridTextColumn Header="Tulemus" Binding="{Binding ResultText}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="ScoreTextBlock" Grid.Row="3" Text="Skoor: Mängija 0 - 0 Arvuti" 
                   FontWeight="Bold" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center"/>
    </Grid>
</Window>